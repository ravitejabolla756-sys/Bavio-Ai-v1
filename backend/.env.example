PORT=3000
NODE_ENV=production

# Database
DATABASE_URL=your_postgres_url

# Supabase (alternative to DATABASE_URL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# Sarvam AI Voice
SARVAM_API_KEY=your_sarvam_key

# Dodo Payments Billing
DODO_API_KEY=your_dodo_key
DODO_STARTER_PRODUCT_ID=pdt_0NdJCmLQ4vEu1ozciOnzC
DODO_GROWTH_PRODUCT_ID=pdt_0NdJCtm1chlF5sdwOymeu
DODO_SCALE_PRODUCT_ID=pdt_0NdJCytZyhPzdBuKpg4sz
DODO_WEBHOOK_SECRET=your_webhook_secret

# Twilio Telephony
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# Exotel Telephony
EXOTEL_API_KEY=your_exotel_key
EXOTEL_API_TOKEN=your_exotel_token
EXOTEL_SID=your_exotel_sid

# Webhook Configuration
WEBHOOK_BASE_URL=https://api.bavio.in
FRONTEND_URL=https://bavio.in

# ── Voice Stack Configuration ─────────────────────────────────────────────────
# VOICE_STACK_PROVIDER controls which AI pipeline processes calls.
#   current_openai  — existing Whisper/GPT-4o/OpenAI TTS pipeline (DEFAULT)
#   modular_v1      — Deepgram Flux + Cerebras + ElevenLabs Flash pipeline
VOICE_STACK_PROVIDER=current_openai

# Percentage of calls (0-100) routed to modular_v1 via deterministic hash.
# 0 = disabled. All existing customers stay on current_openai regardless.
VOICE_STACK_ROLLOUT_PERCENT=0

# Comma-separated business UUIDs always routed to modular_v1 (for testing).
VOICE_STACK_ALLOWED_BUSINESS_IDS=

# AWS region for regional voice worker deployment (informational for now).
VOICE_WORKER_REGION=us-east-1

# Primary and fallback LLM backends for modular_v1.
# Valid values: cerebras | groq | openai
VOICE_PRIMARY_LLM=cerebras
VOICE_FALLBACK_LLM=groq

# ── Deepgram (STT — modular_v1) ──────────────────────────────────────────────
# Required when VOICE_STACK_PROVIDER=modular_v1 or VOICE_STACK_ROLLOUT_PERCENT>0
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-2

# ── Cerebras (Primary LLM — modular_v1) ─────────────────────────────────────
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_MODEL=llama3.1-70b

# ── ElevenLabs (TTS — modular_v1) ───────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ── Groq (Fallback LLM — modular_v1) ────────────────────────────────────────
# Note: if OPENAI_API_KEY is a gsk_ Groq key, GROQ_API_KEY can be left unset
# and the current_openai stack will continue using Groq transparently.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
